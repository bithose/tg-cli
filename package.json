{
  "name": "tg-cli",
  "version": "0.1.0",
  "description": "A small persistent Telegram user CLI built on GramJS.",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.5",
  "keywords": [
    "telegram",
    "cli",
    "gramjs",
    "bun"
  ],
  "bin": {
    "tg-cli": "./src/cli.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    ".env.example",
    "bunfig.toml"
  ],
  "scripts": {
    "tg-cli": "bun run src/cli.ts",
    "start": "bun run src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun test"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "telegram": "^2.26.22"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "typescript": "^5.9.3"
  }
}
